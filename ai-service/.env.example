# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model from https://openrouter.ai/models
# openrouter/free works without paid credits; openai/gpt-4o-mini needs credits.
OPENROUTER_MODEL=openrouter/free

# Optional ranking headers on openrouter.ai
APP_URL=http://localhost
APP_NAME=Newsflow

# MUST match Laravel .env AI_SERVICE_TOKEN
AI_SERVICE_TOKEN=dev-shared-secret
LARAVEL_BASE_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8001
